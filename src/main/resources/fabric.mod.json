{
  "schemaVersion": 1,
  "id": "savedcommands",
  "version": "${version}",
  "name": "Saved Commands",
  "description": "This mod lets you save commands and chat messages for easier access later using keyboard shortcuts and the saved commands menu.",
  "authors": [
    "AliBa2468",
    "Pr77Pr77"
  ],
  "contact": {
    "sources": "https://github.com/Pr77Pr77/savedcommands",
    "issues": "https://github.com/Pr77Pr77/savedcommands/issues",
    "homepage": "https://modrinth.com/mod/savedcommands"
  },
  "license": "GPL-3.0",
  "icon": "assets/savedcommands/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "de.aliba2468pr77pr77.savedcommands.SavedCommands"
    ],
    "client": [
      "de.aliba2468pr77pr77.savedcommands.SavedCommandsClient"
    ],
    "modmenu": [
      "de.aliba2468pr77pr77.savedcommands.ModMenuIntegration"
    ]
  },
  "mixins": [
    "savedcommands.mixins.json",
    {
      "config": "savedcommands.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "savedcommands.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": ">=${minecraft_version} <${next_major_minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/wfeM63Jar5",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/savedcommands",
        "modmenu.modrinth": "https://modrinth.com/mod/savedcommands",
        "modmenu.github_releases": "https://github.com/Pr77Pr77/savedcommands/releases"
      }
    }
  }
}