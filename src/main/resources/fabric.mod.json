{
  "schemaVersion": 1,
  "id": "savedcommands",
  "version": "${version}",
  "name": "Saved Commands",
  "description": "This mod lets you save commands and chat messages for easier access later using keyboard shortcuts and the saved commands menu.",
  "authors": [
    "AliBa2468",
    "Pr77Pr77"
  ],
  "contact": {
    "sources": "https://github.com/Pr77Pr77/savedcommands",
    "issues": "https://github.com/Pr77Pr77/savedcommands/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/savedcommands/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "de.aliba2468pr77pr77.savedcommands.SavedCommands"
    ],
    "client": [
      "de.aliba2468pr77pr77.savedcommands.SavedCommandsClient"
    ]
  },
  "mixins": [
    "savedcommands.mixins.json",
    {
      "config": "savedcommands.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": ["1.21.11"],
    "java": ">=21",
    "fabric-api": "*"
  }
}